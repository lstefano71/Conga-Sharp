 echoSrv;r1;data;h;sname;evt
 CS.Bind ''
 h←CS.Init''
 ⎕←'Server: ',(⍕2⊃CS.Srv h '' '' 8080 'Command')

 :While 1
     evt←CS.Wait h '.' 50000
     :If 'Receive'≡2⊃evt
         data←0(220⌶)3⊃evt
         data←1(220⌶)100+data
         {}CS.Respond h(1⊃evt)data
     :ElseIf 'Closed'≡2⊃evt
         ⎕←'Closed: ',⍕evt
         :Leave
     :ElseIf 'Timeout'≡2⊃evt
         ⎕←'Timeout, waiting...'
     :EndIf
 :EndWhile
 {}CS.Shutdown h
